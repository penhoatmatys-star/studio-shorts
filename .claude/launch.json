{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dfend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d Dfend && node server.js"],
      "port": 3000
    },
    {
      "name": "Static Site (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "Static Site (Python)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    }
  ]
}
